        <mxCell id="p2_2" value="&lt;b&gt;Course&lt;/b&gt;&lt;hr&gt;id : string&lt;br&gt;slug : string&lt;br&gt;title, tagline, description&lt;br&gt;category → Category.id&lt;br&gt;categoryLabel (dupliqué)&lt;br&gt;badge? : string&lt;br&gt;level : Débutant | Intermédiaire | Avancé | Tous niveaux&lt;br&gt;rating, reviewsCount, enrolledCount&lt;br&gt;minHours / maxHours / defaultHours&lt;br&gt;accentColor, thumbnail&lt;br&gt;instructor { name, title, company, avatar }&lt;br&gt;skills[], benefits[]&lt;br&gt;modules : CourseModule[]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
