  <diagram id="5.-Flux-quiz-&amp;-certificat-cible" name="5. Flux quiz &amp; certificat cible">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5_1" value="Flux quiz → certificat corrigé&lt;br&gt;&lt;span style='font-size:12px;font-weight:normal;color:#666'&gt;Corrige B1, B2, B3 et B5 : la décision est prise par le serveur&lt;/span&gt;" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p5_2" value="L'apprenant valide ses réponses" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_3" value="POST /quiz/:id/attempts&lt;br&gt;{ réponses }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_4" value="&lt;b&gt;API&lt;/b&gt; corrige avec les réponses stockées en base&lt;br&gt;(jamais envoyées au client)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_5" value="score ≥ 70 % ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="780" y="85" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_6" value="Tentative enregistrée « échouée »&lt;br&gt;affichage des explications&lt;br&gt;nouvel essai (max 3 / 24 h)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="250" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_7" value="Tentative enregistrée « réussie »&lt;br&gt;module validé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="990" y="100" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_8" value="Tous les modules du palier choisi validés&lt;br&gt;et leçons terminées ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1230" y="70" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5_9" value="Module suivant débloqué&lt;br&gt;(selon requiredTier)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1240" y="260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_10" value="&lt;b&gt;Émission du certificat&lt;/b&gt;&lt;br&gt;ID unique en base (contrainte UNIQUE)&lt;br&gt;score réel = moyenne des quiz&lt;br&gt;heures = heures du palier&lt;br&gt;date ISO + signature HMAC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
