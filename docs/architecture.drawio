          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_24" value="requiredTier n'est lu nulle part : le volume horaire choisi ne débloque ni ne verrouille aucun module." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
