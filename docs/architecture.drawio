          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_20" value="La bonne réponse est livrée au navigateur : on peut la lire dans le bundle JS ou les DevTools." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1160" y="140" width="280" height="70" as="geometry" />
