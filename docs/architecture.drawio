          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_26" value="Une seule « inscription » par cours et un seul utilisateur : pas de notion de compte." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="420" y="680" width="320" height="60" as="geometry" />
