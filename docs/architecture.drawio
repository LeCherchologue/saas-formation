          <mxGeometry x="600" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_7" value="&lt;b&gt;DurationSlider&lt;/b&gt;&lt;br&gt;choix 4 h → 120 h" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="810" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_8" value="Clic « S'inscrire »&lt;br&gt;dispatch('enroll')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1020" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_9" value="&lt;b&gt;LearnPlayerView&lt;/b&gt;&lt;br&gt;/learn/:courseId" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1230" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_10" value="Cocher une leçon&lt;br&gt;dispatch('toggleLesson')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1230" y="260" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_11" value="Ouvrir le quiz d'un module&lt;br&gt;&lt;b&gt;QuizModal&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1020" y="260" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_12" value="Répondre à toutes les questions&lt;br&gt;puis « Valider »" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="810" y="260" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_13" value="Score ≥ seuil ?&lt;br&gt;&lt;i&gt;(test absent)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="610" y="245" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3_14" value="&lt;b&gt;PASS_QUIZ&lt;/b&gt;&lt;br&gt;quiz marqué validé&lt;br&gt;+ certificat créé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="380" y="260" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_15" value="&lt;b&gt;CertificateView&lt;/b&gt;&lt;br&gt;/verify/:id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="190" y="260" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_16" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_2" target="p3_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_3" target="p3_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_19" value="router.push('/courses?q=')" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="p3_4" target="p3_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_20" value="CourseCard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_5" target="p3_6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_6" target="p3_7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_7" target="p3_8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_23" value="router.push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_8" target="p3_9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_9" target="p3_10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_10" target="p3_11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_11" target="p3_12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_12" target="p3_13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_28" value="toujours « oui »" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_13" target="p3_14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_29" value="« Voir mon certificat »" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_14" target="p3_15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3_15" target="p3_16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_31" value="&lt;b&gt;B1 — Aucun seuil de réussite&lt;/b&gt;&lt;br&gt;submitQuiz() appelle passQuiz quel que soit le score : 0 % valide le module et affiche « Validation réussie »." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_32" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="p3_31" target="p3_13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_33" value="&lt;b&gt;B2 — Certificat trop tôt et score falsifié&lt;/b&gt;&lt;br&gt;Émis dès le 1er quiz, même si le cours n'est pas fini ; scorePercent = max(score, 90) ; ID = random 1000-9999 → collisions possibles." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="330" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_34" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="p3_33" target="p3_14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_35" value="&lt;b&gt;B3 — Volume horaire décoratif&lt;/b&gt;&lt;br&gt;requiredTier jamais appliqué ; completedHours = heures choisies, pas heures suivies." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="790" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_36" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="p3_35" target="p3_7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_37" value="&lt;b&gt;B4 — Pas de contrôle d'accès&lt;/b&gt;&lt;br&gt;/learn/:id accessible sans inscription ni compte (TOGGLE_LESSON / PASS_QUIZ créent l'inscription à la volée)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1230" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_38" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="p3_37" target="p3_9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_39" value="&lt;b&gt;B5 — Vérification locale&lt;/b&gt;&lt;br&gt;Le certificat n'existe que dans le localStorage de l'étudiant : un recruteur qui scanne le QR code ne le trouve pas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_40" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="p3_39" target="p3_15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_41" value="&lt;b&gt;B6 — Code dupliqué&lt;/b&gt;&lt;br&gt;La création d'Enrollment est copiée dans 3 mutations ; progression = leçons cochées, sans lien avec le temps passé." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1010" y="400" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3_42" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#b85450;" edge="1" parent="1" source="p3_41" target="p3_10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_43" value="&lt;b&gt;B7 — Fonctions factices&lt;/b&gt;&lt;br&gt;Paiement (/plans), formulaire B2B (alert()) et sélecteur de langue n'ont aucun effet réel." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="330" y="580" width="420" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="4.-Architecture-cible" name="4. Architecture cible">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_1" value="Architecture cible proposée (to-be)&lt;br&gt;&lt;span style='font-size:12px;font-weight:normal;color:#666'&gt;Séparer front et back pour rendre progression, paiements et certificats fiables&lt;/span&gt;" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_2" value="Apprenant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_3" value="Recruteur / employeur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_4" value="Admin / formateur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_5" value="Front-end (Vue 3 + TypeScript)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;arcSize=3;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="170" y="80" width="330" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p4_6" value="&lt;b&gt;SPA Vue 3&lt;/b&gt;&lt;br&gt;routes en lazy-loading&lt;br&gt;gardes de navigation (auth, inscription)&lt;br&gt;vue-i18n (fr / en / es)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_7" value="&lt;b&gt;Pinia&lt;/b&gt; (remplace Vuex)&lt;br&gt;cache de session uniquement,&lt;br&gt;la source de vérité est l'API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="240" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_8" value="&lt;b&gt;Page publique /verify/:id&lt;/b&gt;&lt;br&gt;lecture seule, sans connexion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_9" value="&lt;b&gt;Back-office&lt;/b&gt;&lt;br&gt;gestion cours, modules, quiz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_10" value="&lt;b&gt;PWA&lt;/b&gt;&lt;br&gt;cache des leçons hors-ligne" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="430" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_11" value="API (Node.js — NestJS ou Express)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;arcSize=3;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
