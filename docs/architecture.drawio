          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_22" value="Données copiées (dénormalisées) dans le certificat ; date stockée en texte français → impossible à trier ou traduire." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
